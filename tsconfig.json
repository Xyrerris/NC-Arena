{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // TypeScript 6 no longer auto-includes every node_modules/@types package, so the two
    // that contribute globals rather than module types are named. Without this, `describe`
    // and `expect` are unresolved and `npm run typecheck` fails on every test file.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // backend/ is a second, independent package (ADR-0035) — its own tsconfig, its own
  // dependency tree, targeting Node rather than the Expo/RN toolchain this config extends.
  "exclude": ["node_modules", ".expo", "design", "backend"]
}
