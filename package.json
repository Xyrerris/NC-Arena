{
  "name": "arena-scout",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "node scripts/start-emulator.mjs && expo run:android",
    "emulator": "node scripts/start-emulator.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --passWithNoTests",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:rules": "npm run check:boundaries && npm run check:tokens",
    "e2e": "node scripts/e2e-screenshots.mjs",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run check:rules && npm run format && npm test"
  },
  "dependencies": {
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.15",
    "expo-background-task": "~57.0.12",
    "expo-constants": "~57.0.11",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
