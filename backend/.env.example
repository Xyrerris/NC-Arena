# Copy to .env for local dev, or set these as the `app` service's environment in
# docker-compose.yml (via a .env file next to it — Compose reads that automatically).

# postgres://<user>:<password>@<host>:5432/<database>
# In Docker Compose, <host> is the `db` service name, not localhost.
DATABASE_URL=postgres://arena:arena@localhost:5432/arena_scout

PORT=3000
